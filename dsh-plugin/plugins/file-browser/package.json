{
  "name": "@local/file-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "文件浏览：左侧栏全局文件页，浏览本机任意目录，点文件在右侧预览中打开",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
